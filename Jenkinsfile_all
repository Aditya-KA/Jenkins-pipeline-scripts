pipeline{
    agent none

    parameters{
        string(name: 'stringInput', defaultValue: 'Aditya', description: 'Enter name of employee')
        choice(name: 'choose', choices: ['one','two','three'], description: 'select one')
        booleanParam(name: 'tik', defaultValue: 'false', description: 'tik if you need')
    }

    environment{
        APP = 'frontend'
        DB = 'db_url'
    }

    options{
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '4'))
        disableConcurrentBuilds()
        retry(2)
        parallelsAlwaysFailFast()
    }

    stages{
        
        stage ('calling parameters'){
            agent { label 'slave1' }

            steps{
                echo "String value: ${params.stringInput}"
                echo "choice value: ${params.choose}"
                echo "boolean value : ${params.tik}"
            }
        }
        stage ('calling env'){
           agent { label 'slave1' }

            steps{
                script{
                
                     echo "APP: ${env.APP}"
                     echo "URL: ${env.DB}"
                    
                  
                }

                
            }
        }
      stage ('catchEroor stage'){
          agent { label 'slave2' }
        
          steps{
              catchError(stageResult: 'FAILURE', buildResult: 'SUCCESS'){
                  sh "exit 1" 

              }
          }
      }
      stage ('checkout stage'){
          agent { label 'slave2' }

          steps{

              checkout scmGit(branches: [[name: '*/master']], extensions: [], userRemoteConfigs: [[credentialsId: 'Github-cred', url: 'https://github.com/Aditya-KA/ip-app-python-flask-main.git']])

              sh '''
              ls -lrt
              '''
          }
      }
      stage ('when-env'){
            agent { label 'slave2' }
            when {
                environment name: 'APP', value: 'frontend'
            }
            steps{
                echo "env is correct"
            }
      }
      stage ('env-expression'){
            agent { label 'slave1' }
            when {
                expression {
                    params.stringInput == 'Aditya'
                }
            }
            steps{
                echo "parameter is correct"
            } 
      }
      stage ('env-not'){
        agent { label 'slave1' }
        when {
            not{
                environment name: 'APP', value: 'backend'
                
            }

        }
        steps{
            echo "env is wrong"
        }
      }

      stage ('env-anyof'){
            agent { label 'slave1' }
            when {
                anyOf {
                    environment name: 'APP', value: 'backend'; name: 'APP', value: 'frontend'
                
                }
            }
            steps{
                echo "anyof stage running"
            }
      }

      stage ('when-allof'){
            agent { label 'slave2' }
            when {
                allOf{
                    environment name: 'APP', value: 'backend'; name: 'APP', value: 'frontend'
                    

                }
            }
            steps{
                echo "alloff stage running"
            }
      }
      stage ('parallel'){
        failFast true
        parallel{
            stage ('stage-1'){
                agent { label 'slave2' }
                steps{
                    echo "parllel block stage 1"
                    sh "exit 1"
                }
                post {
                    failure{
                        echo "stage is failed"
                    }
                }
            }
            stage ('stage-2'){
                agent { label 'slave1' }
                steps{
                    echo "parllel stage 2"
                }
            }
        }
      }

    }
    post {
        success{
            echo "stage is success"
        }

        failure{
            echo "stage is failed"
        }
        always{
            echo "running always post block"
        }
    }    
}
