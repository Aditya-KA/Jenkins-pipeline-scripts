pipeline {
    agent any

    stages{
        stage('initial stage') {
            steps {
                echo "hello this is initial stage"
            }
        }
        stage('parllel block') {
            failFast true
            parallel {
                
                stage ('first stage in parllel block') {
                    steps {
                        echo "first stage in parllel block"
                        sh "sleep 100"
                    
                    }
                }

                stage ('second stage in parllel block') {
                    steps {

                        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE'){
                            echo "second stage in parllel block"

                            sh "exit 1"
                        }
                        
                    }
                }

                stage ('third stage in parllel block') {
                    steps {
                        echo "third stage in parllel block"
                        sh "sleep 100"
                    }
                }
                
            }
        }

        stage('final stage') {
            steps {
                echo " this is final block"
            }
        }
    }   

      

}